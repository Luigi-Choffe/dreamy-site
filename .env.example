# ---------------------------------------------------------------------------
# Dreamy Site — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite valores reais.
# Todas as variáveis são opcionais: o site funciona sem elas (integrações ficam
# desativadas e são registradas em log). Ver docs/ARCHITECTURE.md e README.md.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# URL canônica pública (sem barra final). Em preview/dev pode ser omitida.
NEXT_PUBLIC_SITE_URL=https://www.dreamy.app.br
# "production" libera indexação. Qualquer outro valor (ou ausência) => noindex + robots disallow.
# Opt-in explícito: NÃO é inferido de VERCEL_ENV (um deploy em *.vercel.app continua noindex até você definir isto).
NEXT_PUBLIC_SITE_ENV=development

# --- Analytics / tags (carregadas via GTM; só quando o ID existir) ---------
NEXT_PUBLIC_GTM_ID=
# IDs abaixo são configurados DENTRO do GTM (não são lidos pelo código):
# GA4 measurement ID, Meta Pixel ID, LinkedIn Partner ID.
# Mantidos aqui apenas como referência de configuração.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# --- Conversão -------------------------------------------------------------
# CRM: "webhook" (POST JSON para CRM_WEBHOOK_URL) | "none" (apenas log)
CRM_PROVIDER=none
CRM_WEBHOOK_URL=
CRM_API_KEY=

# Notificação de lead por e-mail: "resend" | "none"
EMAIL_PROVIDER=none
EMAIL_PROVIDER_API_KEY=
LEADS_NOTIFICATION_EMAIL=
# Remetente verificado no provedor (ex.: "Dreamy Site <leads@dreamy.app.br>")
LEADS_NOTIFICATION_FROM=

# Ferramenta de agendamento (Cal.com, Calendly, etc.). Se vazio, o passo de
# agendamento não é exibido após o envio do formulário.
NEXT_PUBLIC_BOOKING_URL=

# Cloudflare Turnstile (opcional; ativa somente se ambas as chaves existirem)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Segurança -------------------------------------------------------------
# "true" aplica Content-Security-Policy em modo enforce. Padrão: Report-Only.
CSP_ENFORCE=false
# Store compartilhado (Redis via REST) para rate limit global e idempotência do /api/leads em
# serverless multi-instância. Opcional: sem isto, ambos ficam em memória por instância (ADR-011).
# Aceita KV_REST_API_* (integração Upstash no Vercel Marketplace) ou UPSTASH_REDIS_REST_*.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Outbound (campanhas de e-mail — docs/PRD-EMAIL-OUTBOUND.md) -----------
# Chave da conta Resend DEDICADA ao outbound (separada da conta transacional do site — ADR do PRD §2).
OUTBOUND_RESEND_API_KEY=
# Remetente verificado no domínio de ENVIO dedicado, bedreamy.com.br (ex.: "Luigi Choffe <nome@bedreamy.com.br>"; identidade em src/lib/outbound/signature.ts).
OUTBOUND_FROM=
# Caixa monitorada que recebe as respostas (as respostas são o CTA primário; ex.: contact@bedreamy.com.br).
OUTBOUND_REPLY_TO=
# Janela de envio em horário de São Paulo (default 09:00-17:30, só dias úteis).
OUTBOUND_SEND_WINDOW=
# Offset do fuso de envio (default -03:00).
OUTBOUND_UTC_OFFSET=
# Cap diário manual, além da rampa automática 15→30→50→80 (opcional; vale o MENOR).
OUTBOUND_DAILY_CAP=
# Diretório do store local (default .outbound/ — contém PII, nunca commitar).
OUTBOUND_STORE_DIR=

# --- Plataforma hospedada (pivô 2026-08-29 — PRD-EMAIL-OUTBOUND §29, ADR-023/024, docs/DEPLOY-PLATAFORMA.md) ---
# "true" no projeto Vercel da plataforma: a raiz "/" redireciona (307) para /interno/outbound (o site institucional vive em outro deploy).
OUTBOUND_PLATFORM_ONLY=
# Postgres Neon — connection string POOLED (host com "-pooler"; Storage do projeto Vercel). Sem ela: store em arquivos (.outbound/) — dev/demo.
OUTBOUND_DATABASE_URL=
# Allowlist do login por link mágico: e-mails separados por vírgula, sem espaços, minúsculas. Quem não está aqui não entra.
OUTBOUND_TEAM_EMAILS=
# Segredo HMAC do cookie de sessão (30 dias). Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))". Trocar derruba todas as sessões.
OUTBOUND_SESSION_SECRET=
# URL pública da plataforma, base dos links de login (ex.: https://mork.bedreamy.com.br; em dev http://localhost:3000).
OUTBOUND_APP_URL=
# Copiloto de IA do console (briefing do dia, sugestão de triagem) via API da Anthropic.
# Sem a chave, os recursos de IA mostram aviso e todo o resto funciona normalmente.
OUTBOUND_ANTHROPIC_API_KEY=
# "true" desliga o login do console — SÓ fora de produção (dev/testes); sem efeito em produção.
OUTBOUND_AUTH_DISABLED=

# --- Desenvolvimento -------------------------------------------------------
# "true" exibe cases não aprovados e insights em revisão (somente fora de produção; preview é noindex).
CONTENT_PREVIEW=
# Em dev, leads são gravados em .leads/*.jsonl (gitignored). "false" desativa.
LEADS_DEV_STORE=

# --- Observabilidade -------------------------------------------------------
SENTRY_DSN=
