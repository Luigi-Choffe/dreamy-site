{
  "name": "dreamy-site",
  "version": "0.1.0",
  "private": true,
  "description": "Site institucional B2B da Dreamy — software sob medida e agentes de IA para empresas.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "content:check": "tsx scripts/content-check.ts",
    "audit:screenshots": "tsx scripts/audit-screenshots.ts",
    "qa:screenshots": "tsx scripts/qa-screenshots.ts",
    "smoke": "tsx scripts/smoke.ts",
    "outbound:import": "tsx scripts/outbound/import.ts",
    "outbound:verify": "tsx scripts/outbound/verify.ts",
    "outbound:plan": "tsx scripts/outbound/plan.ts",
    "outbound:send": "tsx scripts/outbound/send.ts",
    "outbound:sync": "tsx scripts/outbound/sync.ts",
    "outbound:auto": "tsx scripts/outbound/auto.ts",
    "outbound:reply": "tsx scripts/outbound/reply.ts",
    "outbound:report": "tsx scripts/outbound/report.ts",
    "outbound:campaign": "tsx scripts/outbound/campaign.ts",
    "outbound:arm": "tsx scripts/outbound/arm.ts",
    "outbound:demo": "tsx scripts/outbound/demo.ts",
    "outbound:companies": "tsx scripts/outbound/companies.ts",
    "outbound:db": "tsx scripts/outbound/db.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm content:check && pnpm test && pnpm build",
    "outbound:crm": "tsx scripts/outbound/crm.ts",
    "outbound:demandas": "tsx scripts/outbound/demandas.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
