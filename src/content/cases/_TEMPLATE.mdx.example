sector: ""            # setor de atuação
summary: ""           # 1 frase: o que foi construído e para quê (vira o H1)
problem: ""           # o que estava impedindo crescimento/eficiência
solution: ""          # o que foi construído
result: ""            # resultado verificável (financeiro ou operacional: "antes/depois")
solutionSlug: sistemas-sob-medida   # nova-receita-digital | sistemas-sob-medida | agentes-de-ia
cover:
  src: /images/cases/<slug>/cover.jpg
  alt: ""
  width: 1600
  height: 900
