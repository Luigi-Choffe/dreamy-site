  #   value: "Fluxo automatizado"
  #   before: "cadastro dependia de processo manual"
  #   after: "cadastro passou a ser realizado através de fluxo automatizado conectado ao sistema"
  #   sourceRef: case-<slug>-cadastro
approved: false
approvalRef: ""       # e-mail/contrato/data da aprovação do cliente
publishedAt: 2026-01-01
featured: false
seo:
  title: ""           # 10–70 caracteres (opcional)
  description: ""     # 50–170 caracteres (opcional)
